{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "ignorePatterns": ["src/routeTree.gen.ts", "src/components/ui/**", "src/hooks/use-mobile.ts"],
  "overrides": [
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
