# Copiar a .env y completar

# Base de datos (docker-compose expone PostgreSQL en el puerto 5433)
DATABASE_URL="postgresql://produccion:produccion_dev@localhost:5433/produccion?schema=public"

# API
PORT=3000
NODE_ENV=development
# Origen del frontend (para CORS en producción; en desarrollo Vite usa proxy)
WEB_ORIGIN=http://localhost:5173

# JWT: usar un valor largo y aleatorio (mín. 32 caracteres)
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_TTL_SEGUNDOS=900
REFRESH_TTL_DIAS=7

# Consulta de DNI al registrar personas (opcional: ese es el valor por defecto; no usa token)
# DNI_API_URL=https://esconsultoresyasesores.com:9300/api/dni-ruc/dni

# Usuario administrador que crea el seed
SEED_ADMIN_EMAIL=admin@grupoes.local
SEED_ADMIN_PASSWORD=cambia-esta-contraseña

# Contraseña de los usuarios de demostración (pnpm db:demo, solo desarrollo)
SEED_DEMO_PASSWORD=cambia-esta-contraseña
