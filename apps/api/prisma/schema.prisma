// Modelo de datos del Sistema de Producción — GRUPO ES
// Documentación completa: docs/modelo-datos.md
//
// Convenciones:
// - Modelos en PascalCase, mapeados a tablas snake_case en singular (@@map).
// - Campos en camelCase, mapeados a columnas snake_case (@map).
// - Llave primaria uuid v7. Auditoría: creado_en/por, actualizado_en/por, eliminado_en.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Usuarios, roles y permisos
// ─────────────────────────────────────────────────────────────

model Usuario {
  id               String    @id @default(uuid(7)) @db.Uuid
  nombres          String    @db.VarChar(100)
  apellidos        String    @db.VarChar(100)
  email            String    @unique @db.VarChar(150)
  celular          String?   @db.VarChar(20)
  fechaNacimiento  DateTime? @map("fecha_nacimiento") @db.Date
  passwordHash     String    @map("password_hash")
  activo           Boolean   @default(true)
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoAcceso     DateTime? @map("ultimo_acceso") @db.Timestamptz(6)

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  actualizadoPor String?   @map("actualizado_por") @db.Uuid
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(6)

  roles              UsuarioRol[]
  permisos           UsuarioPermiso[]   @relation("PermisoDelUsuario")
  permisosOtorgados  UsuarioPermiso[]   @relation("PermisoOtorgadoPor")
  sesiones           Sesion[]
  accesos            AccesoLog[]
  auditorias         Auditoria[]
  prospectosCaptados Prospecto[]        @relation("ProspectoCaptadoPor")
  prospectosACargo   Prospecto[]        @relation("ProspectoResponsable")
  eventosProspecto   ProspectoEvento[]
  tareasCreadas      Tarea[]            @relation("TareaCreadaPor")
  tareasAsignadas    TareaResponsable[] @relation("TareaResponsableUsuario")
  asignacionesHechas TareaResponsable[] @relation("TareaAsignadaPor")

  @@map("usuario")
}

model Rol {
  id          String  @id @default(uuid(7)) @db.Uuid
  codigo      String  @unique @db.VarChar(40)
  nombre      String  @db.VarChar(80)
  descripcion String?
  esSistema   Boolean @default(false) @map("es_sistema")
  activo      Boolean @default(true)

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  actualizadoPor String?   @map("actualizado_por") @db.Uuid
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(6)

  usuarios            UsuarioRol[]
  permisos            RolPermiso[]
  participaciones     ActividadParticipacionRol[]
  actividadesCoordina Actividad[]                 @relation("RolCoordinador")
  responsables        TareaResponsable[]

  @@map("rol")
}

model UsuarioRol {
  usuarioId String @map("usuario_id") @db.Uuid
  rolId     String @map("rol_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model Modulo {
  id      String  @id @default(uuid(7)) @db.Uuid
  codigo  String  @unique @db.VarChar(60)
  nombre  String  @db.VarChar(80)
  padreId String? @map("padre_id") @db.Uuid
  ruta    String? @db.VarChar(120)
  icono   String? @db.VarChar(60)
  orden   Int     @default(0)
  activo  Boolean @default(true)

  padre    Modulo?  @relation("Submodulos", fields: [padreId], references: [id])
  hijos    Modulo[] @relation("Submodulos")
  acciones Accion[]

  @@map("modulo")
}

model Accion {
  id         String  @id @default(uuid(7)) @db.Uuid
  moduloId   String  @map("modulo_id") @db.Uuid
  codigo     String  @db.VarChar(60)
  nombre     String  @db.VarChar(100)
  usaAlcance Boolean @default(false) @map("usa_alcance")
  /// false cuando la acción ya no existe en el catálogo del código
  vigente    Boolean @default(true)

  modulo          Modulo           @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  rolPermisos     RolPermiso[]
  usuarioPermisos UsuarioPermiso[]

  @@unique([moduloId, codigo])
  @@map("accion")
}

enum Alcance {
  propios
  equipo
  todos

  @@map("alcance")
}

model RolPermiso {
  rolId    String   @map("rol_id") @db.Uuid
  accionId String   @map("accion_id") @db.Uuid
  alcance  Alcance?

  rol    Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)
  accion Accion @relation(fields: [accionId], references: [id], onDelete: Cascade)

  @@id([rolId, accionId])
  @@map("rol_permiso")
}

enum TipoPermisoUsuario {
  conceder
  denegar

  @@map("tipo_permiso_usuario")
}

model UsuarioPermiso {
  id          String             @id @default(uuid(7)) @db.Uuid
  usuarioId   String             @map("usuario_id") @db.Uuid
  accionId    String             @map("accion_id") @db.Uuid
  tipo        TipoPermisoUsuario
  alcance     Alcance?
  motivo      String?
  otorgadoPor String?            @map("otorgado_por") @db.Uuid
  fecha       DateTime           @default(now()) @db.Timestamptz(6)

  usuario   Usuario  @relation("PermisoDelUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  accion    Accion   @relation(fields: [accionId], references: [id], onDelete: Cascade)
  otorgante Usuario? @relation("PermisoOtorgadoPor", fields: [otorgadoPor], references: [id])

  @@unique([usuarioId, accionId])
  @@map("usuario_permiso")
}

// ─────────────────────────────────────────────────────────────
// Sesiones y seguridad de acceso
// ─────────────────────────────────────────────────────────────

/// Refresh tokens emitidos (solo se guarda el hash).
model Sesion {
  id               String            @id @default(uuid(7)) @db.Uuid
  usuarioId        String            @map("usuario_id") @db.Uuid
  tokenHash        String            @unique @map("token_hash") @db.VarChar(128)
  expiraEn         DateTime          @map("expira_en") @db.Timestamptz(6)
  revocadaEn       DateTime?         @map("revocada_en") @db.Timestamptz(6)
  motivoRevocacion MotivoRevocacion? @map("motivo_revocacion")
  ip               String?           @db.VarChar(64)
  dispositivo      String?           @db.VarChar(255)
  creadaEn         DateTime          @default(now()) @map("creada_en") @db.Timestamptz(6)
  ultimoUso        DateTime          @default(now()) @map("ultimo_uso") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesion")
}

enum MotivoRevocacion {
  rotada
  logout
  reutilizacion

  @@map("motivo_revocacion")
}

enum ResultadoAcceso {
  exito
  fallo
  bloqueado

  @@map("resultado_acceso")
}

model AccesoLog {
  id           String          @id @default(uuid(7)) @db.Uuid
  usuarioId    String?         @map("usuario_id") @db.Uuid
  emailIntento String          @map("email_intento") @db.VarChar(150)
  fecha        DateTime        @default(now()) @db.Timestamptz(6)
  ip           String?         @db.VarChar(64)
  dispositivo  String?         @db.VarChar(255)
  resultado    ResultadoAcceso

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, fecha])
  @@map("acceso_log")
}

// ─────────────────────────────────────────────────────────────
// Transversales
// ─────────────────────────────────────────────────────────────

model Auditoria {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  accion    String   @db.VarChar(40)
  entidad   String   @db.VarChar(60)
  entidadId String?  @map("entidad_id") @db.Uuid
  antes     Json?
  despues   Json?
  ip        String?  @db.VarChar(64)
  fecha     DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([fecha])
  @@map("auditoria")
}

model Parametro {
  clave         String   @id @db.VarChar(80)
  valor         Json
  descripcion   String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("parametro")
}

/// Correlativos por año para los códigos legibles (P-2026-0001, T-2026-0001...).
model Correlativo {
  serie  String @db.VarChar(10)
  anio   Int
  ultimo Int    @default(0)

  @@id([serie, anio])
  @@map("correlativo")
}

// ─────────────────────────────────────────────────────────────
// Catálogos
// ─────────────────────────────────────────────────────────────

model TipoTrabajo {
  id             String  @id @default(uuid(7)) @db.Uuid
  nombre         String  @unique @db.VarChar(80)
  maxIntegrantes Int     @default(1) @map("max_integrantes")
  diasGarantia   Int     @default(0) @map("dias_garantia")
  orden          Int     @default(0)
  activo         Boolean @default(true)

  prospectos Prospecto[]

  @@map("tipo_trabajo")
}

model PrioridadTrabajo {
  id                      String  @id @default(uuid(7)) @db.Uuid
  nombre                  String  @unique @db.VarChar(40)
  /// 1 = más urgente
  nivel                   Int
  color                   String  @db.VarChar(20)
  permiteInsercionUrgente Boolean @default(false) @map("permite_insercion_urgente")
  porDefecto              Boolean @default(false) @map("por_defecto")
  activo                  Boolean @default(true)

  prospectos Prospecto[]

  @@map("prioridad_trabajo")
}

model Universidad {
  id           String   @id @default(uuid(7)) @db.Uuid
  nombre       String   @unique @db.VarChar(200)
  siglas       String?  @db.VarChar(30)
  maxSimilitud Decimal? @map("max_similitud") @db.Decimal(5, 2)
  maxIa        Decimal? @map("max_ia") @db.Decimal(5, 2)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  creadoPor    String?  @map("creado_por") @db.Uuid

  prospectos Prospecto[]

  @@map("universidad")
}

model Carrera {
  id        String   @id @default(uuid(7)) @db.Uuid
  nombre    String   @unique @db.VarChar(150)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  creadoPor String?  @map("creado_por") @db.Uuid

  prospectos Prospecto[]

  @@map("carrera")
}

model NivelAcademico {
  id     String  @id @default(uuid(7)) @db.Uuid
  nombre String  @unique @db.VarChar(80)
  orden  Int     @default(0)
  activo Boolean @default(true)

  prospectos Prospecto[]

  @@map("nivel_academico")
}

model OrigenContacto {
  id         String  @id @default(uuid(7)) @db.Uuid
  nombre     String  @unique @db.VarChar(60)
  /// Si es true, el formulario pide "referido por".
  esReferido Boolean @default(false) @map("es_referido")
  orden      Int     @default(0)
  activo     Boolean @default(true)

  prospectos Prospecto[]

  @@map("origen_contacto")
}

enum ClaseEtapa {
  abierta
  ganada
  perdida

  @@map("clase_etapa")
}

model EtapaProspecto {
  id                String         @id @default(uuid(7)) @db.Uuid
  nombre            String         @unique @db.VarChar(60)
  orden             Int
  color             String         @db.VarChar(20)
  clase             ClaseEtapa     @default(abierta)
  /// Etapa en la que empieza todo prospecto nuevo.
  inicial           Boolean        @default(false)
  activa            Boolean        @default(true)
  /// Movimiento automático: el prospecto pasa a esta etapa cuando ocurre este evento con esta actividad.
  actividadEventoId String?        @map("actividad_evento_id") @db.Uuid
  momentoEvento     MomentoEvento? @map("momento_evento")

  actividadEvento Actividad?  @relation(fields: [actividadEventoId], references: [id])
  prospectos      Prospecto[]

  @@map("etapa_prospecto")
}

model MotivoPerdida {
  id     String  @id @default(uuid(7)) @db.Uuid
  nombre String  @unique @db.VarChar(80)
  orden  Int     @default(0)
  activo Boolean @default(true)

  prospectos Prospecto[]

  @@map("motivo_perdida")
}

// ─────────────────────────────────────────────────────────────
// Comercial: personas y prospectos
// ─────────────────────────────────────────────────────────────

enum TipoDocumento {
  DNI
  CE
  PASAPORTE

  @@map("tipo_documento")
}

model Persona {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// Celular/WhatsApp normalizado (+51987654321). Identifica a la persona.
  celular         String         @unique @db.VarChar(20)
  nombres         String?        @db.VarChar(100)
  apellidos       String?        @db.VarChar(100)
  email           String?        @db.VarChar(150)
  tipoDocumento   TipoDocumento? @map("tipo_documento")
  numeroDocumento String?        @map("numero_documento") @db.VarChar(20)

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  actualizadoPor String?   @map("actualizado_por") @db.Uuid
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(6)

  prospectos ProspectoContacto[]
  referidos  Prospecto[]         @relation("ReferidoPor")
  tareas     TareaPersona[]

  @@unique([tipoDocumento, numeroDocumento])
  @@map("persona")
}

enum Temperatura {
  caliente
  tibio
  frio

  @@map("temperatura")
}

model Prospecto {
  id                    String       @id @default(uuid(7)) @db.Uuid
  codigo                String       @unique @db.VarChar(20)
  tipoTrabajoId         String       @map("tipo_trabajo_id") @db.Uuid
  titulo                String?      @db.VarChar(300)
  prioridadId           String       @map("prioridad_id") @db.Uuid
  universidadId         String?      @map("universidad_id") @db.Uuid
  carreraId             String?      @map("carrera_id") @db.Uuid
  nivelAcademicoId      String?      @map("nivel_academico_id") @db.Uuid
  fechaEntregaTentativa DateTime?    @map("fecha_entrega_tentativa") @db.Date
  origenId              String       @map("origen_id") @db.Uuid
  referidoPorId         String?      @map("referido_por_id") @db.Uuid
  linkDrive             String?      @map("link_drive") @db.VarChar(500)
  observaciones         String?
  detalles              String?
  etapaId               String       @map("etapa_id") @db.Uuid
  temperatura           Temperatura?
  montoCotizado         Decimal?     @map("monto_cotizado") @db.Decimal(12, 2)
  fechaCotizacion       DateTime?    @map("fecha_cotizacion") @db.Date
  motivoPerdidaId       String?      @map("motivo_perdida_id") @db.Uuid
  intentosSinRespuesta  Int          @default(0) @map("intentos_sin_respuesta")
  captadoPorId          String       @map("captado_por_id") @db.Uuid
  responsableId         String       @map("responsable_id") @db.Uuid

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  actualizadoPor String?   @map("actualizado_por") @db.Uuid
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(6)

  tipoTrabajo    TipoTrabajo      @relation(fields: [tipoTrabajoId], references: [id])
  prioridad      PrioridadTrabajo @relation(fields: [prioridadId], references: [id])
  universidad    Universidad?     @relation(fields: [universidadId], references: [id])
  carrera        Carrera?         @relation(fields: [carreraId], references: [id])
  nivelAcademico NivelAcademico?  @relation(fields: [nivelAcademicoId], references: [id])
  origen         OrigenContacto   @relation(fields: [origenId], references: [id])
  referidoPor    Persona?         @relation("ReferidoPor", fields: [referidoPorId], references: [id])
  etapa          EtapaProspecto   @relation(fields: [etapaId], references: [id])
  motivoPerdida  MotivoPerdida?   @relation(fields: [motivoPerdidaId], references: [id])
  captadoPor     Usuario          @relation("ProspectoCaptadoPor", fields: [captadoPorId], references: [id])
  responsable    Usuario          @relation("ProspectoResponsable", fields: [responsableId], references: [id])

  contactos ProspectoContacto[]
  eventos   ProspectoEvento[]
  tareas    Tarea[]

  @@index([responsableId, etapaId])
  @@index([etapaId])
  @@index([creadoEn])
  @@map("prospecto")
}

model ProspectoContacto {
  prospectoId String  @map("prospecto_id") @db.Uuid
  personaId   String  @map("persona_id") @db.Uuid
  esPrincipal Boolean @default(false) @map("es_principal")
  orden       Int     @default(0)

  prospecto Prospecto @relation(fields: [prospectoId], references: [id], onDelete: Cascade)
  persona   Persona   @relation(fields: [personaId], references: [id])

  @@id([prospectoId, personaId])
  @@index([personaId])
  @@map("prospecto_contacto")
}

enum TipoEventoProspecto {
  creado
  editado
  cambio_etapa
  nota
  contacto
  reasignado
  tarea

  @@map("tipo_evento_prospecto")
}

/// Línea de tiempo del prospecto.
model ProspectoEvento {
  id          String              @id @default(uuid(7)) @db.Uuid
  prospectoId String              @map("prospecto_id") @db.Uuid
  tipo        TipoEventoProspecto
  detalle     String
  datos       Json?
  usuarioId   String?             @map("usuario_id") @db.Uuid
  fecha       DateTime            @default(now()) @db.Timestamptz(6)

  prospecto Prospecto @relation(fields: [prospectoId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([prospectoId, fecha])
  @@map("prospecto_evento")
}

model ResultadoContacto {
  id                 String  @id @default(uuid(7)) @db.Uuid
  nombre             String  @unique @db.VarChar(60)
  /// Suma un intento sin respuesta (p. ej. "No contestó").
  cuentaSinRespuesta Boolean @default(false) @map("cuenta_sin_respuesta")
  orden              Int     @default(0)
  activo             Boolean @default(true)

  tareas Tarea[]

  @@map("resultado_contacto")
}

// ─────────────────────────────────────────────────────────────
// Actividades y tareas
// ─────────────────────────────────────────────────────────────

enum ComportamientoActividad {
  reunion
  contacto
  produccion
  correccion
  revision
  administrativa
  entrega

  @@map("comportamiento_actividad")
}

enum AplicaA {
  prospecto
  cliente
  ambos

  @@map("aplica_a")
}

enum ModoAsignacion {
  /// Se asigna a quien crea la tarea.
  creador
  /// Quien crea la tarea elige al responsable.
  directa
  /// Queda "por asignar" en la bandeja del rol coordinador.
  coordinada
  /// Al auxiliar principal del trabajo (clientes).
  responsable_trabajo

  @@map("modo_asignacion")
}

enum MomentoEvento {
  al_programar
  al_completar

  @@map("momento_evento")
}

model TipoActividad {
  id             String                  @id @default(uuid(7)) @db.Uuid
  nombre         String                  @unique @db.VarChar(60)
  comportamiento ComportamientoActividad
  color          String                  @db.VarChar(20)
  activo         Boolean                 @default(true)

  actividades Actividad[]

  @@map("tipo_actividad")
}

model Actividad {
  id               String         @id @default(uuid(7)) @db.Uuid
  nombre           String         @unique @db.VarChar(100)
  tipoActividadId  String         @map("tipo_actividad_id") @db.Uuid
  minutosEstimados Int            @map("minutos_estimados")
  aplicaA          AplicaA        @map("aplica_a")
  requiereHoraFija Boolean        @default(false) @map("requiere_hora_fija")
  modoAsignacion   ModoAsignacion @map("modo_asignacion")
  rolCoordinadorId String?        @map("rol_coordinador_id") @db.Uuid
  /// Pide resultado del contacto y el siguiente seguimiento al completarse.
  esSeguimiento    Boolean        @default(false) @map("es_seguimiento")
  orden            Int            @default(0)
  activa           Boolean        @default(true)

  tipo            TipoActividad            @relation(fields: [tipoActividadId], references: [id])
  rolCoordinador  Rol?                     @relation("RolCoordinador", fields: [rolCoordinadorId], references: [id])
  participaciones ActividadParticipacion[]
  tareas          Tarea[]
  etapasEvento    EtapaProspecto[]

  @@map("actividad")
}

model PrioridadRol {
  id     String @id @default(uuid(7)) @db.Uuid
  nombre String @unique @db.VarChar(40)
  /// 1 = principal
  nivel  Int    @unique
  color  String @db.VarChar(20)

  roles        ActividadParticipacionRol[]
  responsables TareaResponsable[]

  @@map("prioridad_rol")
}

model ActividadParticipacion {
  id          String  @id @default(uuid(7)) @db.Uuid
  actividadId String  @map("actividad_id") @db.Uuid
  nombre      String  @db.VarChar(80)
  cantidad    Int     @default(1)
  obligatoria Boolean @default(true)
  orden       Int     @default(0)

  actividad    Actividad                   @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  roles        ActividadParticipacionRol[]
  responsables TareaResponsable[]

  @@unique([actividadId, nombre])
  @@map("actividad_participacion")
}

model ActividadParticipacionRol {
  participacionId String @map("participacion_id") @db.Uuid
  rolId           String @map("rol_id") @db.Uuid
  prioridadRolId  String @map("prioridad_rol_id") @db.Uuid

  participacion ActividadParticipacion @relation(fields: [participacionId], references: [id], onDelete: Cascade)
  rol           Rol                    @relation(fields: [rolId], references: [id], onDelete: Cascade)
  prioridad     PrioridadRol           @relation(fields: [prioridadRolId], references: [id])

  @@id([participacionId, rolId])
  @@map("actividad_participacion_rol")
}

enum EstadoTarea {
  por_asignar
  pendiente
  en_proceso
  completada
  cancelada
  no_asistio

  @@map("estado_tarea")
}

enum Modalidad {
  presencial
  virtual

  @@map("modalidad")
}

model Tarea {
  id                  String      @id @default(uuid(7)) @db.Uuid
  actividadId         String      @map("actividad_id") @db.Uuid
  /// Por ahora solo tareas de prospectos; las de trabajos se agregan con el módulo de trabajos.
  prospectoId         String?     @map("prospecto_id") @db.Uuid
  /// Día planificado (hora de Lima).
  fecha               DateTime    @db.Date
  /// Inicio exacto, si la tarea tiene hora (obligatorio en reuniones).
  inicio              DateTime?   @db.Timestamptz(6)
  minutosEstimados    Int         @map("minutos_estimados")
  modalidad           Modalidad?
  estado              EstadoTarea
  notas               String?
  resultadoContactoId String?     @map("resultado_contacto_id") @db.Uuid
  resultado           String?
  completadaEn        DateTime?   @map("completada_en") @db.Timestamptz(6)
  motivoCancelacion   String?     @map("motivo_cancelacion")
  vecesReprogramada   Int         @default(0) @map("veces_reprogramada")
  creadaPorId         String      @map("creada_por_id") @db.Uuid

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  actividad         Actividad          @relation(fields: [actividadId], references: [id])
  prospecto         Prospecto?         @relation(fields: [prospectoId], references: [id], onDelete: Cascade)
  resultadoContacto ResultadoContacto? @relation(fields: [resultadoContactoId], references: [id])
  creadaPor         Usuario            @relation("TareaCreadaPor", fields: [creadaPorId], references: [id])
  responsables      TareaResponsable[]
  personas          TareaPersona[]

  @@index([prospectoId, estado])
  @@index([estado, fecha])
  @@map("tarea")
}

model TareaResponsable {
  id              String   @id @default(uuid(7)) @db.Uuid
  tareaId         String   @map("tarea_id") @db.Uuid
  usuarioId       String   @map("usuario_id") @db.Uuid
  participacionId String   @map("participacion_id") @db.Uuid
  /// Con qué rol participa y con qué prioridad (copiados al asignar).
  rolId           String   @map("rol_id") @db.Uuid
  prioridadRolId  String?  @map("prioridad_rol_id") @db.Uuid
  asignadoPorId   String   @map("asignado_por_id") @db.Uuid
  asignadoEn      DateTime @default(now()) @map("asignado_en") @db.Timestamptz(6)
  /// Se asignó pese a un choque de horario o a una prioridad menor.
  forzado         Boolean  @default(false)
  motivoForzado   String?  @map("motivo_forzado")

  tarea         Tarea                  @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario       Usuario                @relation("TareaResponsableUsuario", fields: [usuarioId], references: [id])
  participacion ActividadParticipacion @relation(fields: [participacionId], references: [id])
  rol           Rol                    @relation(fields: [rolId], references: [id])
  prioridad     PrioridadRol?          @relation(fields: [prioridadRolId], references: [id])
  asignadoPor   Usuario                @relation("TareaAsignadaPor", fields: [asignadoPorId], references: [id])

  @@unique([tareaId, usuarioId])
  @@index([usuarioId])
  @@map("tarea_responsable")
}

/// Contactos o integrantes que participan en la tarea (p. ej. quienes asisten al enfoque).
model TareaPersona {
  tareaId   String @map("tarea_id") @db.Uuid
  personaId String @map("persona_id") @db.Uuid

  tarea   Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  persona Persona @relation(fields: [personaId], references: [id])

  @@id([tareaId, personaId])
  @@map("tarea_persona")
}
