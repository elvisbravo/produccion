# /etc/systemd/system/grupoes-api.service
# Cambia "grupoes" por el usuario del servidor y la ruta si instalaste en otra carpeta.
[Unit]
Description=GRUPO ES - API de producción
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=grupoes
WorkingDirectory=/srv/grupoes/produccion/apps/api
# Las variables (DATABASE_URL, JWT_ACCESS_SECRET, WEB_ORIGIN…) se leen de este archivo.
EnvironmentFile=/srv/grupoes/produccion/apps/api/.env
ExecStart=/usr/bin/node dist/main
Restart=on-failure
RestartSec=5
# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
