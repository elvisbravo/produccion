# Copiar a ".env" en la raíz del proyecto (en el servidor) y completar. No se sube a git.

# Tu subdominio, sin https:// (debe apuntar a la IP del servidor)
DOMINIO=produccion.tudominio.com

# Contraseña de la base de datos: genera una con   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secreto de las sesiones: genera uno con   openssl rand -hex 48
JWT_ACCESS_SECRET=

# Administrador que crea el seed (la clave es temporal: el sistema obliga a cambiarla al entrar)
SEED_ADMIN_EMAIL=tu-correo@tudominio.com
SEED_ADMIN_PASSWORD=

# ── Cómo se publica ────────────────────────────────────────────────────────────
# Opción A: el servidor ya tiene Apache o Nginx en los puertos 80/443 (déjalo así).
# La web queda solo en 127.0.0.1:8080 y tu Apache/Nginx la reenvía (ver docs/despliegue.md).
WEB_PORT=8080

# Opción B: el servidor está libre. Caddy publica 80/443 con HTTPS automático. Descomenta:
# COMPOSE_PROFILES=https
