# Copiar a ".env" en la raíz del proyecto (en el servidor) y completar. No se sube a git.

# Tu dominio, sin https:// (debe apuntar a la IP del servidor)
DOMINIO=produccion.tudominio.com

# Contraseña de la base de datos: genera una con   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secreto de las sesiones: genera uno con   openssl rand -hex 48
JWT_ACCESS_SECRET=

# Administrador que crea el seed (la clave es temporal: el sistema obliga a cambiarla al entrar)
SEED_ADMIN_EMAIL=tu-correo@tudominio.com
SEED_ADMIN_PASSWORD=

# HTTPS automático con Caddy (puertos 80 y 443). Quítalo si ya tienes un Nginx en el servidor.
COMPOSE_PROFILES=https

# Puerto local de la web (solo si usas tu propio Nginx en lugar de Caddy)
# WEB_PORT=8080
